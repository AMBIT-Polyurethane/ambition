# Copy these into Vercel > Project > Settings > Environment Variables.
# (For local development, copy this file to .env.local.)

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional: the app's public address (no trailing slash). Vercel's address is used if blank.
NEXT_PUBLIC_SITE_URL=

# Where orders and access requests are emailed
ORDERS_EMAIL=orders@ambitpu.com
ADMIN_NOTIFY_EMAIL=jeremiah.bryant@ambitpu.com

# Email sending - pick ONE option. With neither set, orders are still saved and
# show on Admin > Orders; nothing is emailed.
# Option A: Resend (needs DNS records on ambitpu.com)
RESEND_API_KEY=
EMAIL_FROM=AMBIT Intelligence <orders@ambitpu.com>
# Option B: Microsoft 365 via Graph (needs IT to grant Mail.Send to the app registration)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_SENDER_MAILBOX=orders@ambitpu.com

# Customer approval of staff orders (email link). Turns on by itself once email can reach
# customers (Resend with a verified domain + EMAIL_FROM, or Microsoft 365). off = never, on = always.
CUSTOMER_APPROVAL=

# Show the "Sign in with Microsoft" button (after IT sets up the app registration)
NEXT_PUBLIC_MICROSOFT_SIGNIN=false

# Price requests: reps see their own; admins approve prices in the app (saved back into Jotform).
# Jotform > Settings (your picture, top right) > API > Create New Key > set it to "Full Access".
# (A "Read Access" key still shows requests, but approving prices in the app will be refused.)
JOTFORM_API_KEY=
# Optional (these are the defaults):
# JOTFORM_API_URL=https://ambit-polyurethane.jotform.com/API
# PRF_FORM_ID=252896183848172

# Live inventory (Admin > Inventory). The same three MS_ values as above (the "AMBIT Intelligence" app registration),
# with the delegated permissions Files.ReadWrite.All, offline_access and User.Read, plus the Supabase secret key
# (Supabase > Project Settings > API Keys > Secret keys). Never put the secret key in a NEXT_PUBLIC_ setting.
SUPABASE_SECRET_KEY=
# Optional: Vercel sends this with the 2-minute inventory timer; with it set, nobody else can start a sync.
CRON_SECRET=

# Ask AMBIT (the AI assistant): an API key from platform.claude.com (Settings > API keys), with billing set up.
# Model, approved websites, limits and who can use it are set in the app: Admin > Ask AMBIT > Settings.
ANTHROPIC_API_KEY=
